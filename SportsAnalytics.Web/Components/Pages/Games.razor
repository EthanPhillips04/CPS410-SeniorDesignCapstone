@page "/games"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using SportsAnalytics.Web.Data
@using SportsAnalytics.Web.Models
@using SportsAnalytics.Web.Services

@inject IDbContextFactory<SportsDbContext> DbFactory
@inject NbaImportService NbaService

<h1>NBA Games & Player Statistics</h1>

<p>
    Browse NBA games and view individual player box scores.
</p>

<hr />

<!-- SINGLE DATE IMPORT -->

<h4>Import Game Statistics</h4>

<div class="d-flex gap-2 flex-wrap mb-4">
    <div>
        <label class="form-label">Game Date</label>
        <input type="date"
               class="form-control"
               @bind="importDate"
               disabled="@loading" />
    </div>

    <div class="align-self-end">
        <button class="btn btn-primary"
                disabled="@loading"
                @onclick="ImportStats">
            @(loading ? "Importing..." : "Import Game Stats")
        </button>
    </div>
</div>

<hr />

<!-- DATE RANGE IMPORT -->

<h4>Import Multiple Game Dates</h4>

<p>
    Import up to seven consecutive days of NBA game statistics.
</p>

<div class="d-flex gap-3 flex-wrap mb-3">
    <div>
        <label class="form-label">Start Date</label>
        <input type="date"
               class="form-control"
               @bind="rangeStartDate"
               disabled="@loading" />
    </div>

    <div>
        <label class="form-label">End Date</label>
        <input type="date"
               class="form-control"
               @bind="rangeEndDate"
               disabled="@loading" />
    </div>

    <div class="align-self-end">
        <button class="btn btn-success"
                disabled="@loading"
                @onclick="ImportDateRange">
            @(loading ? "Importing..." : "Import Date Range")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(importProgress))
{
    <div class="alert alert-info mt-3" role="status">
        @importProgress
    </div>
}

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-secondary mt-3" role="status">
        @statusMessage
    </div>
}

<hr class="my-4" />

<!-- GAME FILTERS -->

<h3>Browse Stored NBA Games</h3>

<div class="row g-3 mb-3">

    <div class="col-md-3">
        <label class="form-label">Season</label>

        <select class="form-select"
                @bind="selectedSeason"
                @bind:after="ApplyFilters"
                disabled="@loading">

            <option value="0">All Seasons</option>

            @foreach (int season in availableSeasons)
            {
                <option value="@season">
                    @season-@(season + 1)
                </option>
            }

        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Team</label>

        <select class="form-select"
                @bind="selectedTeamId"
                @bind:after="ApplyFilters"
                disabled="@loading">

            <option value="0">All Teams</option>

            @foreach (var team in teams)
            {
                <option value="@team.BallDontLieTeamId">
                    @team.Name
                </option>
            }

        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Game Date</label>

        <input type="date"
               class="form-control"
               @bind="selectedDate"
               @bind:after="ApplyFilters"
               disabled="@loading" />
    </div>

    <div class="col-md-2 align-self-end">
        <button class="btn btn-outline-secondary w-100"
                disabled="@loading"
                @onclick="ClearFilters">
            Clear Filters
        </button>
    </div>

</div>

<div class="d-flex justify-content-between
    align-items-center flex-wrap gap-2 mb-3">

    <strong>Matching Games: @totalGames</strong>

    <button class="btn btn-secondary"
            disabled="@loading"
            @onclick="RefreshGames">
        Refresh Games
    </button>

</div>

<!-- STORED GAME LIST -->
@if (games.Count == 0)
{
    <p>
        No stored games match your filters.
        Try another season, team, or date.
    </p>
}
else
{
    @foreach (var game in games)
    {
        <div class="card mb-3" @key="game.Id">
            <div class="card-body">

                <button class="btn btn-link text-start w-100"
                        disabled="@loading"
                        @onclick="() => SelectGame(game.Id)">

                    <div class="d-flex justify-content-between
                        align-items-center">

                        <div>
                            <strong>
                                @TeamName(game.VisitorTeamId)
                                @@
                                @TeamName(game.HomeTeamId)
                            </strong>

                            <div class="text-muted">
                                @game.GameDate.ToString("MMM dd, yyyy")
                                -
                                @game.Status
                            </div>

                            <div>
                                @game.VisitorTeamScore
                                -
                                @game.HomeTeamScore
                            </div>
                        </div>

                        <span>
                            @(selectedGameId == game.Id
                                ? "Hide Stats ▲"
                                : "View Stats ▼")
                        </span>
                    </div>
                </button>

                <!-- EXPANDABLE PLAYER STATISTICS -->
                @if (selectedGameId == game.Id)
                {
                    <hr />

                    @if (loading)
                    {
                        <p>Loading player statistics...</p>
                    }
                    else if (selectedStats.Count == 0)
                    {
                        <p>
                            No player statistics are stored
                            for this game.
                        </p>
                    }
                    else
                    {
                        @foreach (int teamId in new[]
                        {
                            game.VisitorTeamId,
                            game.HomeTeamId
                        })
                        {
                            var teamStats = selectedStats
                                .Where(s =>
                                    s.BallDontLieTeamId == teamId)
                                .OrderByDescending(s => s.Points)
                                .ToList();

                            <h5 class="mt-3">
                                @TeamName(teamId)
                            </h5>

                            @if (teamStats.Count == 0)
                            {
                                <p>No player stats available.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-sm">
                                        <thead>
                                            <tr>
                                                <th>Player</th>
                                                <th>MIN</th>
                                                <th>PTS</th>
                                                <th>REB</th>
                                                <th>AST</th>
                                                <th>STL</th>
                                                <th>BLK</th>
                                                <th>TO</th>
                                                <th>FG</th>
                                                <th>3PT</th>
                                                <th>FT</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var stat in teamStats)
                                            {
                                                <tr>
                                                    <td>
                                                        @stat.Player.FirstName
                                                        @stat.Player.LastName
                                                    </td>

                                                    <td>@stat.Minutes</td>
                                                    <td>@stat.Points</td>
                                                    <td>@stat.Rebounds</td>
                                                    <td>@stat.Assists</td>
                                                    <td>@stat.Steals</td>
                                                    <td>@stat.Blocks</td>
                                                    <td>@stat.Turnovers</td>

                                                    <td>
                                                        @(stat.FieldGoalsMade)/@(stat.FieldGoalsAttempted)
                                                    </td>

                                                    <td>
                                                        @(stat.ThreePointersMade)/@(stat.ThreePointersAttempted)
                                                    </td>

                                                    <td>
                                                        @(stat.FreeThrowsMade)/@(stat.FreeThrowsAttempted)
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    }
                }
            </div>
        </div>
    }
}

<!-- PAGINATION -->
@if (totalPages > 1)
{
    <div class="d-flex justify-content-between
        align-items-center mt-4 mb-4">

        <button class="btn btn-outline-primary"
                disabled="@(loading || currentPage <= 1)"
                @onclick="() => GoToPage(currentPage - 1)">
            Previous
        </button>

        <span>
            Page @currentPage of @totalPages
        </span>

        <button class="btn btn-outline-primary"
                disabled="@(loading || currentPage >= totalPages)"
                @onclick="() => GoToPage(currentPage + 1)">
            Next
        </button>

    </div>
}

@code {

    // IMPORT DATES

    private DateOnly importDate =
        new(2026, 11, 12);

    private DateOnly rangeStartDate =
        new(2026, 10, 20);

    private DateOnly rangeEndDate =
        new(2026, 10, 26);


    // STORED DATA

    private List<NbaGame> games = new();

    private List<NbaPlayerGameStat> selectedStats = new();

    private List<NbaTeam> teams = new();

    private Dictionary<int, string> teamNames = new();

    private List<int> availableSeasons = new();


    // FILTER SETTINGS

    private int selectedSeason = 2026;

    // Zero means all teams.
    private int selectedTeamId = 0;

    // Null means all dates.
    private DateOnly? selectedDate = null;


    // PAGINATION

    private const int PageSize = 20;

    private int currentPage = 1;

    private int totalGames = 0;

    private int totalPages =>
        Math.Max(1, (int)Math.Ceiling(
            totalGames / (double)PageSize));


    // PAGE STATE

    private int? selectedGameId = null;

    private bool loading = false;

    private string statusMessage = "";

    private string importProgress = "";


    // INITIAL PAGE LOAD

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterOptions();
        await LoadGames();
    }


    // LOAD FILTER OPTIONS

    private async Task LoadFilterOptions()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        teams = await db.NbaTeams
            .AsNoTracking()
            .OrderBy(t => t.Name)
            .ToListAsync();

        teamNames = teams.ToDictionary(
            t => t.BallDontLieTeamId,
            t => t.Name);

        availableSeasons = await db.NbaGames
            .AsNoTracking()
            .Select(g => g.Season)
            .Distinct()
            .OrderByDescending(s => s)
            .ToListAsync();
    }


    // LOAD FILTERED, PAGINATED GAMES

    private async Task LoadGames()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        IQueryable<NbaGame> query =
            db.NbaGames.AsNoTracking();

        // Filter by NBA season.
        if (selectedSeason != 0)
        {
            query = query.Where(g =>
                g.Season == selectedSeason);
        }

        // Filter by either home or visiting team.
        if (selectedTeamId != 0)
        {
            query = query.Where(g =>
                g.HomeTeamId == selectedTeamId ||
                g.VisitorTeamId == selectedTeamId);
        }

        // Filter by exact game date.
        if (selectedDate.HasValue)
        {
            DateOnly date = selectedDate.Value;

            query = query.Where(g =>
                g.GameDate == date);
        }

        // Count matching records before pagination.
        totalGames = await query.CountAsync();

        // Keep the page number valid.
        currentPage = Math.Clamp(
            currentPage, 1, totalPages);

        games = await query
            .OrderByDescending(g => g.GameDate)
            .ThenByDescending(g => g.Id)
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();

        // Close any previously expanded game.
        selectedGameId = null;
        selectedStats.Clear();
    }


    // GET TEAM NAME

    private string TeamName(int teamId)
    {
        return teamNames.TryGetValue(teamId, out var name)
            ? name
            : $"Team {teamId}";
    }


    // APPLY FILTERS

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadGames();
    }

    // CLEAR FILTERS

    private async Task ClearFilters()
    {
        selectedSeason = 0;
        selectedTeamId = 0;
        selectedDate = null;

        currentPage = 1;

        await LoadGames();
    }

    // CHANGE PAGE

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages)
            return;

        currentPage = page;

        await LoadGames();
    }

    // EXPAND / COLLAPSE GAME

    private async Task SelectGame(int gameId)
    {
        if (selectedGameId == gameId)
        {
            selectedGameId = null;
            selectedStats.Clear();
            return;
        }

        loading = true;

        selectedGameId = gameId;
        selectedStats.Clear();

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            selectedStats = await db.NbaPlayerGameStats
                .Include(s => s.Player)
                .AsNoTracking()
                .Where(s => s.NbaGameId == gameId)
                .OrderByDescending(s => s.Points)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            statusMessage =
                $"Unable to load statistics: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    // REFRESH GAMES

    private async Task RefreshGames()
    {
        if (loading)
            return;

        loading = true;

        try
        {
            await LoadFilterOptions();
            await LoadGames();

            statusMessage = "Games refreshed.";
        }
        catch (Exception ex)
        {
            statusMessage =
                $"Refresh failed: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    // IMPORT ONE DATE

    private async Task ImportStats()
    {
        if (loading)
            return;

        loading = true;

        importProgress = "";
        statusMessage = "Importing game statistics...";

        try
        {
            int count = await NbaService
                .ImportGameStatsForDateAsync(importDate);

            await LoadFilterOptions();
            await LoadGames();

            statusMessage =
                $"Successfully processed {count} player-game " +
                $"records for {importDate:yyyy-MM-dd}.";
        }
        catch (Exception ex)
        {
            statusMessage =
                $"Import failed: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    // IMPORT DATE RANGE

    private async Task ImportDateRange()
    {
        if (loading)
            return;

        loading = true;

        statusMessage = "";
        importProgress = "Starting date-range import...";

        try
        {
            int total = await NbaService
                .ImportGameStatsRangeAsync(
                    rangeStartDate,
                    rangeEndDate,
                    async (date, count) =>
                    {
                        await InvokeAsync(() =>
                        {
                            importProgress =
                                $"Completed {date:yyyy-MM-dd}: " +
                                $"{count} player-stat records processed.";

                            StateHasChanged();
                        });
                    });

            await LoadFilterOptions();
            await LoadGames();

            statusMessage =
                $"Date-range import completed. " +
                $"{total} player-game records processed.";

            importProgress = "Import complete.";
        }
        catch (Exception ex)
        {
            statusMessage =
                $"Date-range import stopped: {ex.Message}";

            importProgress =
                "Previously completed dates remain saved. " +
                "Check the error before retrying.";
        }
        finally
        {
            loading = false;
        }
    }
}
